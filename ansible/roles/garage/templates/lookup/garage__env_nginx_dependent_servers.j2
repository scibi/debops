{% set garage__tpl_servers = [] %}
{% set garage__tpl_s3_proxy_options = (
     'proxy_http_version 1.1;\n'
     ~ 'proxy_read_timeout 15m;\n'
     ~ 'proxy_send_timeout 15m;\n'
     ~ 'proxy_request_buffering off;\n'
     ~ 'proxy_max_temp_file_size 0;'
) %}
{% set garage__tpl_s3_options = (
     'client_max_body_size 0;\n'
     ~ 'proxy_buffering off;\n'
     ~ 'ignore_invalid_headers off;'
) %}
{% set garage__tpl_s3_headers = (
     'proxy_set_header Host              $http_host;\n'
     ~ 'proxy_set_header X-Real-IP         $remote_addr;\n'
     ~ 'proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;\n'
     ~ 'proxy_set_header X-Forwarded-Proto $scheme;'
) %}
{% set garage__tpl_web_headers = (
     'proxy_set_header Host              $host;\n'
     ~ 'proxy_set_header X-Real-IP         $remote_addr;\n'
     ~ 'proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;\n'
     ~ 'proxy_set_header X-Forwarded-Proto $scheme;'
) %}
{% set _ = garage__tpl_servers.append({
     'name': [garage__nginx_s3_fqdn, '*.s3.' ~ garage__domain],
     'filename': 'garage-s3',
     'state': ('present' if (garage__deploy_state == 'present' and (garage__nginx_enabled | bool)) else 'absent'),
     'type': 'proxy',
     'options': garage__tpl_s3_options,
     'proxy_pass': 'http://garage-s3',
     'proxy_options': garage__tpl_s3_proxy_options,
     'proxy_headers': garage__tpl_s3_headers
}) %}
{% set _ = garage__tpl_servers.append({
     'name': [garage__nginx_web_fqdn, '*.web.' ~ garage__domain],
     'filename': 'garage-web',
     'state': ('present' if (garage__deploy_state == 'present' and (garage__nginx_enabled | bool) and (garage__nginx_web_enabled | bool)) else 'absent'),
     'type': 'proxy',
     'options': garage__tpl_s3_options,
     'proxy_pass': 'http://garage-web',
     'proxy_options': garage__tpl_s3_proxy_options,
     'proxy_headers': garage__tpl_web_headers
}) %}
{{ garage__tpl_servers | to_yaml }}
