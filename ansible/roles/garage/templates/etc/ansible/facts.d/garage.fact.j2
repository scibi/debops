from __future__ import print_function
from json import dumps
import os
import re
import subprocess

BIN_PATH = "{{ garage__bin_path }}"


def run_cmd(args):
    try:
        stdout = subprocess.check_output(
            args,
            stderr=subprocess.STDOUT
        )
    except Exception:
        return None
    return stdout.decode("utf-8", errors="replace").strip()


def read_version():
    if not os.access(BIN_PATH, os.X_OK):
        return None
    stdout = run_cmd([BIN_PATH, "--version"])
    if not stdout:
        stdout = run_cmd([BIN_PATH, "-V"])
    if not stdout:
        return None
    match = re.search(r"v?(\d+\.\d+\.\d+)", stdout)
    return match.group(1) if match else None


def series_of(version):
    if not version:
        return None
    parts = version.split(".")
    try:
        major = int(parts[0])
    except (TypeError, ValueError):
        return None
    if major >= 1:
        return str(major)
    if len(parts) >= 2:
        return "{}.{}".format(parts[0], parts[1])
    return version


def read_node_id():
    stdout = run_cmd([BIN_PATH, "node", "id"])
    if not stdout:
        return None
    return stdout.split("@", 1)[0].strip() or None


def read_layout_version():
    stdout = run_cmd([BIN_PATH, "layout", "show"])
    if not stdout:
        return None
    match = re.search(r"layout version:\s*(\d+)", stdout, re.I)
    if match:
        return int(match.group(1))
    match = re.search(r"^Version:\s*(\d+)", stdout, re.I | re.M)
    if match:
        return int(match.group(1))
    return None


def main():
    output = {
        "installed": os.access(BIN_PATH, os.X_OK),
        "bin_path": BIN_PATH,
    }
    version = read_version()
    if version is not None:
        output["version"] = version
        series = series_of(version)
        if series is not None:
            output["series"] = series
    node_id = read_node_id()
    if node_id is not None:
        output["node_id"] = node_id
    layout_version = read_layout_version()
    if layout_version is not None:
        output["layout_version"] = layout_version
    print(dumps(output, sort_keys=True, indent=4))


if __name__ == "__main__":
    main()
